# Every key below is optional: with none set you get the demo (synthetic
# data). Sign-in is always required: the first visit asks you to create the
# admin account. `make check` validates this file; broken settings (e.g.
# AUTH_USER without AUTH_PASS, SMTP half-configured, a non-http(s) webhook
# URL) stop the server at startup with a list of fixes. SKIP_CONFIG_CHECK=1
# (in the environment) bypasses the check.
#
# This file holds secrets: keep it out of git (it is in .gitignore) and
# readable by you only (chmod 600 .env; the app writes it that way).

# --- SERP provider (one is required for real searches) ---
# Apify: Google desktop/mobile and Bing. https://console.apify.com/account/integrations
APIFY_API_KEY=
# Serper.dev: Google desktop only, prepaid credits. https://serper.dev
SERPER_API_KEY=
# SERP_PROVIDER: apify | serper. Empty = auto: apify if APIFY_API_KEY is set,
# else serper if SERPER_API_KEY is set. Also editable in Settings -> Search.
SERP_PROVIDER=
# USD per 1,000 Serper.dev credits, only to ESTIMATE its spend for the
# monthly budget (Serper bills credits: 1 per search of up to 10 results).
# Starter pack 1.00, larger packs down to 0.30.
SERPER_USD_PER_1K=1.00

# --- Dashboard auth ---
# Optional env admin (12+ characters). Without it, create the admin account
# on first visit (/setup/admin) and more users in Settings -> Users.
AUTH_USER=
AUTH_PASS=

# --- Email alerts (optional) ---
# SMTP_HOST, SMTP_USER and SMTP_PASS go together (all or none). SMTP_PORT:
# 465 = SSL, anything else = STARTTLS. SMTP_FROM/ALERT_EMAIL default to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=

# --- Telegram notifications (optional) ---
# Bot token from @BotFather. The chat id is NOT set here: save it in
# Settings -> Notifications or the setup wizard (stored in the database as
# "telegram_chat_id"). To find it, send any message to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
TELEGRAM_BOT_TOKEN=

# --- Slack notifications (optional) ---
# Incoming Webhook URL (https://api.slack.com/messaging/webhooks).
SLACK_WEBHOOK_URL=

# --- ntfy notifications (optional) ---
# NTFY_URL: full topic URL if you self-host; takes priority over NTFY_TOPIC.
# If only NTFY_TOPIC is set, the public https://ntfy.sh/<topic> is used.
NTFY_URL=
NTFY_TOPIC=

# --- AI provider (optional) ---
# Same-name detection, severity scores, "Reclassify with AI", AI domain
# suggestions and the PDF summary. Without a provider, results are labelled
# by the rules only. Also editable in Settings -> General -> AI provider.
# LLM_PROVIDER: gemini | openai. Empty = auto: gemini if GEMINI_API_KEY is
# set, else openai if OPENAI_BASE_URL or OPENAI_API_KEY is set.
LLM_PROVIDER=

# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI-compatible: OpenAI, OpenRouter, or a local server. OPENAI_BASE_URL is
# the full base INCLUDING the version path (empty = https://api.openai.com/v1):
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   OpenRouter https://openrouter.ai/api/v1
# A local server keeps result data on your machine.
# OPENAI_API_KEY is required for api.openai.com, optional for local servers.
# OPENAI_MODEL is required for any server other than api.openai.com
# (default there: gpt-4o-mini).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Database path (optional; defaults to data/seo_dashboard.db) ---
# Its directory must be creatable/writable (checked at startup).
# Tests override this with a temporary database (see tests/conftest.py).
DB_PATH=

# --- Other (optional) ---
# Name used in AI prompts and report titles when no tracked name is saved
# in Settings -> General.
# SUBJECT_QUERY=
# Write Settings/setup changes to this file instead of the repo .env (the
# variable itself must be set in the environment, not in this file).
# ENV_FILE=

# --- Security (see SECURITY.md) ---
# Local demos only: no sign-in while no account exists. Refused at startup
# unless HOST is a loopback address, and only served to loopback clients.
# ALLOW_NO_AUTH=1
# Behind an HTTPS reverse proxy: redirect http -> https, HSTS, Secure cookies.
# FORCE_HTTPS=1
# Reverse proxy addresses allowed to set X-Forwarded-For/-Proto (comma list).
# TRUSTED_PROXIES=127.0.0.1
# Encrypts secret-ish values stored in the database (Telegram chat id).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it OUT of database backups.
# APP_ENCRYPTION_KEY=
# Sessions: idle timeout (minutes, default 120) and absolute lifetime (hours, default 12).
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=12
# Largest accepted request body in bytes (default 1048576).
# MAX_BODY_BYTES=1048576
# Rate limits: RATE_LIMIT_ENABLED=0 turns them off; per rule RATE_LIMIT_<RULE>=N/SECONDS
# (rules: LOGIN, SETUP, PASSWORD, API, ASSISTANT, SEARCH, REPORTS, INTEGRATION_TEST, GLOBAL).
# RATE_LIMIT_LOGIN=10/60
# Minimum seconds between showing the sign-in / create-admin form and submitting it.
# BOT_MIN_SUBMIT_SECONDS=1
